---
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Przewiń w dół' } = Astro.props;
---

<a href={href} class="scroll-down" aria-label={label}>
  <svg
    viewBox="0 0 24 24"
    width="32"
    height="32"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 5v14"></path>
    <path d="M5 12l7 7 7-7"></path>
  </svg>
</a>
